{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/loop-engineering/n8n-daily-plan/output.schema.json",
  "title": "Daily plan draft",
  "type": "object",
  "required": ["priority_items", "schedulable_items", "missing_information", "excluded_items", "warnings"],
  "properties": {
    "priority_items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "schedulable_items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "missing_information": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "excluded_items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["source_id", "title", "reason"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
